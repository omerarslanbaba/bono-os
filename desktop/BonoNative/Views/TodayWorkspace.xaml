<UserControl x:Class="BonoNative.Views.TodayWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#121317">
 <UserControl.Resources>
  <Style x:Key="KpiCard" TargetType="Border"><Setter Property="Background" Value="#181A1E"/><Setter Property="BorderBrush" Value="#30343A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="14"/></Style>
  <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="#181A1E"/><Setter Property="BorderBrush" Value="#30343A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="16"/></Style>
  <DataTemplate x:Key="BriefTemplate">
   <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding When}" Foreground="#A0A9B0" FontSize="11" TextWrapping="Wrap" Margin="0,2,10,0"/>
    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="#E9EDF0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Foreground="#929BA3" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="HearingTemplate">
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Court}" FontWeight="SemiBold" Foreground="#F0F3F5" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Foreground="#9AA4AD" FontSize="11" Margin="0,4,0,0"/></StackPanel>
    <TextBlock Text="→" Grid.Column="1" Foreground="#19AEE6" FontSize="16" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,0,3,20">
   <TextBlock Text="Bugün" FontSize="26" FontWeight="Bold" Foreground="#F4F6F7"/>
   <TextBlock Text="Günün duruşma, süre ve işlem görünümü." FontSize="12" Foreground="#969DA5" Margin="0,4,0,16"/>
   <UniformGrid Columns="4" Margin="0,0,0,14">
    <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="◷  BUGÜNKÜ DURUŞMA" Foreground="#A0A8B0" FontSize="11"/><TextBlock x:Name="TodayHearings" Text="—" Foreground="#F4F6F7" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="⚖  7 GÜN İÇİNDEKİ DURUŞMA" Foreground="#A0A8B0" FontSize="11"/><TextBlock x:Name="WeekHearings" Text="—" Foreground="#F4F6F7" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="!  7 GÜN İÇİNDEKİ SÜRE" Foreground="#A0A8B0" FontSize="11"/><TextBlock x:Name="UrgentDeadlines" Text="—" Foreground="#F4F6F7" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource KpiCard}"><StackPanel><TextBlock Text="✓  BUGÜNKÜ AÇIK İŞ" Foreground="#A0A8B0" FontSize="11"/><TextBlock x:Name="TodayTasks" Text="—" ToolTip="Bu sayaç mevcut API tarafından sağlanmıyor." Foreground="#F4F6F7" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
   </UniformGrid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource PanelCard}">
     <StackPanel><TextBlock Text="◷   Günlük Özet" FontSize="15" FontWeight="SemiBold" Foreground="#F0F4F6" Margin="0,0,0,15"/>
      <TextBlock x:Name="BriefEmpty" Text="Bugün için kayıt yok." Foreground="#969DA5" Visibility="Collapsed"/>
      <ItemsControl x:Name="BriefItems" ItemTemplate="{StaticResource BriefTemplate}"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
     <StackPanel><TextBlock Text="⚖   Yaklaşan Duruşmalar" FontSize="15" FontWeight="SemiBold" Foreground="#F0F4F6" Margin="0,0,0,15"/>
      <TextBlock x:Name="HearingsEmpty" Text="Yaklaşan duruşma yok." Foreground="#969DA5" Visibility="Collapsed"/>
      <ItemsControl x:Name="HearingItems" ItemTemplate="{StaticResource HearingTemplate}"/>
     </StackPanel>
    </Border>
   </Grid>
   <TextBlock x:Name="ErrorText" Foreground="#F0B46C" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>