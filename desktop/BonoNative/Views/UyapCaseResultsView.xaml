<UserControl x:Class="BonoNative.Views.UyapCaseResultsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#121317">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="⚖  Dosya Sorgulama Sonuçları" FontSize="17" FontWeight="SemiBold" Foreground="#F0F3F5"/>
    <TextBlock x:Name="CountText" Margin="0,5,0,0" Foreground="#969DA5" FontSize="11" Text="UYAP dosyaları yükleniyor…"/></StackPanel>
   <Button Grid.Column="1" Content="↻  Yenile" Click="Refresh_Click" Padding="12,6"/>
  </Grid>
  <TextBox x:Name="QueryBox" Grid.Row="1" Height="37" Margin="0,0,0,12" Padding="10,6" TextChanged="Query_Changed"
   ToolTip="Mahkeme, esas numarası veya FÖY ile ara" Background="#202329" Foreground="#E8EDF0" BorderBrush="#33383D"/>
  <Border Grid.Row="2" Background="#17191D" BorderBrush="#30343A" BorderThickness="1" CornerRadius="5">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock x:Name="EmptyText" Text="UYAP dosyası bulunamadı." Foreground="#969DA5" Margin="14" Visibility="Collapsed"/>
     <ItemsControl x:Name="Results">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Click="OpenCase_Click" Tag="{Binding}" HorizontalContentAlignment="Stretch" Padding="12,11" Margin="0"
         Background="Transparent" BorderBrush="#30343A" BorderThickness="0,0,0,1" Cursor="Hand">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
          <Border Background="#232529" BorderBrush="#373B40" BorderThickness="1" CornerRadius="4" Padding="7,5" VerticalAlignment="Center" HorizontalAlignment="Left">
           <TextBlock Text="{Binding Badge}" Foreground="#B5BDC4" FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="8,0">
           <TextBlock Text="{Binding Headline}" Foreground="#F0F3F5" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding Subtitle}" Foreground="#9AA3AA" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="→" Foreground="#6DCDF2" FontSize="16" VerticalAlignment="Center"/>
         </Grid>
        </Button>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>