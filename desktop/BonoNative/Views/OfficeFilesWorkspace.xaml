<UserControl x:Class="BonoNative.Views.OfficeFilesWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BonoNative.Views"
             Background="#121317">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Surface" Color="#181A1E"/>
    <SolidColorBrush x:Key="Stroke" Color="#30343A"/>
    <SolidColorBrush x:Key="MutedText" Color="#9BA4AC"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF1F4"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#22262B"/>
      <Setter Property="Foreground" Value="#EEF1F4"/>
      <Setter Property="BorderBrush" Value="#39444A"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#22262B"/>
      <Setter Property="Foreground" Value="#101518"/>
      <Setter Property="BorderBrush" Value="#39444A"/>
      <Setter Property="Padding" Value="6,7"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#20282D"/>
      <Setter Property="Foreground" Value="#EDF5F8"/>
      <Setter Property="BorderBrush" Value="#38434B"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Dosyalarım"/>
        <TextBlock Foreground="{StaticResource MutedText}" Margin="0,6,0,0"
                   Text="Föyleri, müvekkilleri ve ofis dosyalarını tek ekrandan yönet."/>
      </StackPanel>
      <Button Grid.Column="1" Content="↻  Yenile" Click="Refresh_Click" VerticalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
            BorderThickness="1" CornerRadius="7" Padding="18">
      <StackPanel>
        <TextBlock Text="DOSYA SORGULAMA" Foreground="#19AEE6" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <WrapPanel>
          <StackPanel Margin="0,0,12,12" Width="300">
            <TextBlock Text="Föy / Müvekkil / Dosya" Foreground="{StaticResource MutedText}" Margin="0,0,0,5"/>
            <TextBox x:Name="QueryBox" Height="39" TextChanged="Filter_Changed"/>
          </StackPanel>
          <StackPanel Margin="0,0,12,12" Width="180">
            <TextBlock Text="Durum" Foreground="{StaticResource MutedText}" Margin="0,0,0,5"/>
            <ComboBox x:Name="StatusFilter" Height="39" SelectionChanged="Filter_Changed">
              <ComboBoxItem Content="Tümü" IsSelected="True"/>
              <ComboBoxItem Content="Açık"/>
              <ComboBoxItem Content="Kapalı"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,12" Width="170">
            <TextBlock Text="Sıralama" Foreground="{StaticResource MutedText}" Margin="0,0,0,5"/>
            <ComboBox x:Name="SortFilter" Height="39" SelectionChanged="Filter_Changed">
              <ComboBoxItem Content="Föy" IsSelected="True"/>
              <ComboBoxItem Content="Müvekkil"/>
              <ComboBoxItem Content="Dosya adı"/>
            </ComboBox>
          </StackPanel>
          <Button Content="Temizle" VerticalAlignment="Center" Click="Reset_Click"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
            BorderThickness="1" CornerRadius="7">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="18,14">
          <TextBlock x:Name="CountText" FontWeight="SemiBold" Text="Dosyalar yükleniyor…"/>
          <TextBlock x:Name="ErrorText" Foreground="#F3B56B" Margin="16,0,0,0"/>
        </DockPanel>
        <DataGrid Grid.Row="1" x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" RowHeight="49" HeadersVisibility="Column"
                  Background="#181A1E" Foreground="#F0F3F5" RowBackground="#181A1E"
                  AlternatingRowBackground="#202329" AlternationCount="2"
                  BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#34383D" MouseDoubleClick="OpenFile_DoubleClick">
          <DataGrid.Resources>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#202329"/>
              <Setter Property="Foreground" Value="#DDE4E8"/>
              <Setter Property="Padding" Value="12,13"/>
            </Style>
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTextColumn Header="FÖY" Binding="{Binding FileNo}" Width="95"/>
            <DataGridTextColumn Header="Müvekkil" Binding="{Binding Client}" Width="220"/>
            <DataGridTextColumn Header="Dosya" Binding="{Binding Title}" Width="*"/>
            <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/>
            <DataGridTextColumn Header="Bağlı dosya" Binding="{Binding CaseCount}" Width="95"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
    <local:OfficeFileDetailView x:Name="DetailView" Grid.RowSpan="5" Visibility="Collapsed" BackRequested="DetailBack_Click"/>
  </Grid>
</UserControl>