<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BONO OS Web Desktop</AssemblyName>
    <RootNamespace>BonoWebDesktop</RootNamespace>
    <ApplicationIcon>Assets\bono-os.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
    <Resource Include="Assets\bono-os-logo.png" />
  </ItemGroup>
</Project>