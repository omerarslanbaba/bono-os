<Window x:Class="BonoWebDesktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="BONO OS" Width="1600" Height="960" MinWidth="1050" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="#121317">
 <Grid>
  <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
  <Border x:Name="LoadingPanel" Background="#121317">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
    <TextBlock Text="BONO OS" HorizontalAlignment="Center" Foreground="#F4F6F7" FontSize="32" FontWeight="Bold"/>
    <TextBlock Text="Eski BONO OS arayüzü masaüstünde açılıyor…" Margin="0,18,0,0" TextAlignment="Center" Foreground="#AAB0B7"/>
    <TextBlock x:Name="StatusText" Text="Yerel BONO Core bağlantısı kontrol ediliyor." Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="#D8B76B"/>
    <Button Content="Tekrar Dene" Width="140" Height="38" Margin="0,22,0,0" Click="Retry_Click" Background="#193C4B" Foreground="White" BorderBrush="#19AEE6"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>